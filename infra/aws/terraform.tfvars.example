# Copy to terraform.tfvars (git-ignored). Nothing here is secret.

alert_email = "you@example.com"

# Phase 1: test deploy on the load balancer's own address.
enable_https     = false
site_on_aws      = false
enable_schedules = false

# Copy today's records from the current DNS host before switching name servers.
# Example shapes only; replace with the real records.
existing_dns_records = {
  # site_today = { name = "",    type = "A",     records = ["203.0.113.10"] }
  # www_today  = { name = "www", type = "CNAME", records = ["current-host.example.net"] }
  # mail       = { name = "",    type = "MX",    records = ["10 mx1.example.net"] }
  # spf        = { name = "",    type = "TXT",   records = ["v=spf1 include:example.net ~all"] }
}

# Set once the IVS playback key pair is imported (listening parties).
ivs_playback_key_pair_arn = ""

# Extra non-secret settings for the app.
# Full list of setting names: "Environment variables the app receives" in README.md.
app_environment = {
  # FROM_EMAIL                 = "hello@directfanz.io"
  # FROM_NAME                  = "DirectFanz"
  # APPLICATION_FEE_PERCENTAGE = "10"
  # SMS_PROVIDER               = ""   # unset = texts off
  # MARKETING_WEBHOOK_URL      = ""   # unset = feed off; must be https
}
