# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/

# Environment variables
.env*
!.env.example
!.env.*.example
!.env.*.template
!.env.*.sample

# Testing
coverage/
.nyc_output/

# Local databases (never commit — may contain real user data / password hashes)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/**/*.db

# Secrets / credential dumps (never commit)
cookies.txt
*.pem
*.key
# AWS ECS task definitions may embed secrets — keep them out of the repo
production-app-task.json
production-task-definition.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Temporary folders
tmp/
temp/
.vercel

# Local file uploads (don't commit user uploads)
public/uploads/content/
public/uploads/temp/
!public/uploads/.gitkeep
security-backup-*/
~/

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/terraform.tfstate
infrastructure/terraform/terraform.tfstate.backup
infrastructure/terraform/terraform.tfvars
infrastructure/terraform-backup-*/

# Large binary files
*.zip
*.tgz
*.tar.gz

# AWS and deployment artifacts
.serverless/
logs/
*.log

# TypeScript incremental build info (build artifact)
tsconfig.tsbuildinfo
*.tsbuildinfo
